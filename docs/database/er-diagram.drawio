ry></mxCell><mxCell id="c373" value="foreign key inside the module (many → exactly one)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="928.4" y="1064.0" width="530.0" height="24.0" as="geometry"/></mxCell><mxCell id="e374" value="" style="html=1;strokeWidth=2;strokeColor=#333333;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;dashed=1;dashPattern=8 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="792.4" y="1110.0" as="sourcePoint"/><mxPoint x="912.4" y="1110.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c375" value="ID reference to another module: no FK, validated by its facade" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="928.4" y="1098.0" width="530.0" height="24.0" as="geometry"/></mxCell><mxCell id="e376" value="" style="html=1;strokeWidth=2;strokeColor=#333333;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=12;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="792.4" y="1144.0" as="sourcePoint"/><mxPoint x="912.4" y="1144.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c377" value="optional reference (nullable column)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="928.4" y="1132.0" width="530.0" height="24.0" as="geometry"/></mxCell><mxCell id="c378" value="Line color = module of the referenced table" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792.4" y="1166.0" width="670.0" height="24.0" as="geometry"/></mxCell><mxCell id="c379" value='&lt;span style="color:#9A6B00"&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/span&gt;  &lt;span style="color:#1F5FA8"&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/span&gt;  &lt;span style="color:#7A7A7A"&gt;&lt;b&gt;ID&lt;/b&gt;&lt;/span&gt; cross-module ID  &lt;span style="color:#6A6A6A"&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/span&gt; unique' style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792.4" y="1192.0" width="670.0" height="24.0" as="geometry"/></mxCell><mxCell id="c380" value='&lt;span style="color:#9A9A9A"&gt;&lt;i&gt;column *&lt;/i&gt;&lt;/span&gt; not in the ROTEIRO table: audit rule and Spring Modulith' style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792.4" y="1218.0" width="670.0" height="24.0" as="geometry"/></mxCell><mxCell id="c381" value="Types are suggestions; only custo_kg NUMERIC(15,4) and JSONB come from the spec" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792.4" y="1244.0" width="670.0" height="24.0" as="geometry"/></mxCell><mxCell id="c382" value="XOR: a CHECK guarantees exactly one of the two columns is set" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792.4" y="1270.0" width="670.0" height="24.0" as="geometry"/></mxCell><mxCell id="c383" value="atualizado_por references auth.users (not drawn, to keep the diagram readable)" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792.4" y="1296.0" width="670.0" height="24.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
